# Server-only subscription key from the De Lijn developer portal.
# Copy this file to .env.local, fill in the key, then restart Vite or the server.
# Never use a VITE_ prefix for secrets.
# Leave blank to use the bundled public timetable animation without a key.
DELIJN_API_KEY=

# Optional: route names/types extracted from a matching GTFS Static v3 ZIP.
# DELIJN_ROUTES_FILE=../data/ghent/delijn-routes.json

# For a static frontend hosted separately, point it to the Node proxy's public URL.
# VITE_DELIJN_PROXY_URL=https://your-transit-server.example/api/delijn
# On that Node server, allow exactly the frontend origin:
# DELIJN_ALLOWED_ORIGIN=https://your-viewer.example
